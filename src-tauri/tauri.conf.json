{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "对话看板",
  "version": "0.7.1",
  "identifier": "com.desktopnotes.stickynotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "对话看板",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:desktop-notes.db"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
